{
  "type": "module",
  "name": "focus-desktop-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop dashboard em Tauri com Svelte e Vite.",
  "scripts": {
    "check:setup": "node tools/check-setup.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "npm run lint:frontend && npm run lint:rust",
    "lint:frontend": "eslint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "npm run format:frontend && npm run format:rust",
    "format:frontend": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke/app.smoke.test.js",
    "ci": "npm run format:check && npm run format:rust:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^8.0.1",
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "vitest": "^3.1.1",
    "jsdom": "^26.0.0",
    "@testing-library/svelte": "^5.2.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "svelte": "^5.54.0"
  }
}
