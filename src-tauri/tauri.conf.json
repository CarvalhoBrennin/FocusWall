{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Focus Dashboard",
  "version": "0.1.0",
  "identifier": "com.carva.focusdashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Focus Dashboard",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://economia.awesomeapi.com.br; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
